{
  "identifier": "default",
  "description": "Default capabilities for Critterbar",
  "windows": ["overlay", "panel"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-set-ignore-cursor-events",
    "core:event:default",
    "core:event:allow-listen",
    "core:event:allow-emit",
    "updater:default",
    "process:default"
  ]
}
